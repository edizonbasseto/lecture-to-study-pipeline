# Base64-encoded HMAC key (at least 32 bytes) that signs quality-gate
# certificates (ADR 0026). Read from the process environment, or from the
# .env file in the working directory only.
LECTURE_STUDY_QUALITY_HMAC_KEY_B64=

# Study site (ADR 0029). Each defaults to the path shown.
# LECTURE_STUDY_SITE_CREDENTIALS=config/site-credentials.txt
# LECTURE_STUDY_SITE_SESSION_KEY=config/session-key/site-session-key
# LECTURE_STUDY_SITE_MOCK_EXAMS=workspace/data/14_mock_exams
# LECTURE_STUDY_SITE_ACADEMIC_SCHEDULE=config/academic-calendar.local.yaml

# Git hooks: path to the private denylist (default shown). Kept outside
# the repository on purpose; see scripts/denylist_scan.py.
# LECTURE_STUDY_DENYLIST=~/.config/lecture-to-study-pipeline/denylist.txt

# The Codex CLI keeps its own authentication under ~/.codex; nothing here.
