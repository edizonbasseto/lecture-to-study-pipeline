#!/bin/sh
# Last line of defence: scans every commit about to be pushed -- content,
# messages, and author/committer identities -- against the denylist and
# gitleaks, whatever hooks did or did not run when those commits were made.
set -eu
. "$(git rev-parse --show-toplevel)/.githooks/_denylist.sh"

zero_sha=0000000000000000000000000000000000000000
pushed=$(mktemp)
trap 'rm -f "$pushed"' EXIT

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero_sha" ] && continue
    if [ "$remote_sha" = "$zero_sha" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    : > "$pushed"
    git log -p --text --no-ext-diff --no-textconv --no-color \
        --format='%an%n%ae%n%cn%n%ce%n%B' "$range" > "$pushed"
    scan_file_against_denylist "$pushed"
    gitleaks git --log-opts="$range" --redact --no-banner
done
