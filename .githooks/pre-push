#!/bin/sh
# Last line of defence: scans everything about to be published -- commit
# content (merge diffs included), messages, author/committer identities,
# ref names, and annotated tag objects -- against the denylist and gitleaks,
# whatever hooks did or did not run when those commits were made.
set -eu
. "$(git rev-parse --show-toplevel)/.githooks/_denylist.sh"

zero_sha=0000000000000000000000000000000000000000
pushed=$(mktemp)
trap 'rm -f "$pushed"' EXIT

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero_sha" ] && continue
    if [ "$remote_sha" = "$zero_sha" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    printf '%s\n%s\n' "$local_ref" "$remote_ref" > "$pushed"
    if [ "$(git cat-file -t "$local_sha")" = tag ]; then
        git cat-file -p "$local_sha" >> "$pushed"
    fi
    git -c core.quotePath=false log -p --diff-merges=separate --text \
        --no-ext-diff --no-textconv --no-color \
        --format='%an%n%ae%n%cn%n%ce%n%B' "$range" >> "$pushed"
    scan_file_against_denylist "$pushed"
    gitleaks git --log-opts="$range" --redact --no-banner
done
