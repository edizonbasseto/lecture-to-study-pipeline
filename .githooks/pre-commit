#!/bin/sh
# Blocks a commit whose staged additions or file names contain a denylisted
# term or a secret. Binary content is scanned as text; external diff and
# textconv drivers are bypassed and paths are printed unquoted, so neither
# configuration nor non-ASCII file names can hide content.
set -eu
. "$(git rev-parse --show-toplevel)/.githooks/_denylist.sh"

diff_output=$(mktemp)
staged=$(mktemp)
trap 'rm -f "$diff_output" "$staged"' EXIT

git -c core.quotePath=false diff --cached --text --no-ext-diff --no-textconv \
    --no-color --unified=0 --diff-filter=ACMRT --output-indicator-new='>' \
    > "$diff_output"
sed -n 's/^>//p' "$diff_output" > "$staged"
git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRT >> "$staged"

scan_file_against_denylist "$staged"
gitleaks git --pre-commit --staged --redact --no-banner
